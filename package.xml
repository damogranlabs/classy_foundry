<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">

    <!-- For information about the contents of this file see
    https://freecad.github.io/Addon-Academy/Topics/Structuring/Manifest/ -->

    <!--[ Info ]-->

    <name>classy_foundry</name>
    <description>A FreeCAD workbench to interactively and visually build classy_blocks meshes</description>
    <version>0.0.0</version>
    <date>2026-06-14</date>

    <!--[ Ecosystem Requirements ]-->

    <freecadmin>1.1.1</freecadmin>
    <pythonmin>3.10</pythonmin>

    <!--[ Dependencies ]-->

    <depend type="python">numpy</depend>
    <depend type="python">scipy</depend>
    <depend type="python">nptyping</depend>
    <depend type="python">numba</depend>
    <depend type="python">classy_blocks</depend>

    <!--[ Tags ]-->

    <tag>OpenFOAM</tag>
    <tag>Meshing</tag>
    <tag>blockMesh</tag>

    <!--[ Maintainers ]-->

    <maintainer email="nejc.jurkovic@proton.me">Nejc Jurkovič</maintainer>

    <!--[ Authors ]-->

    <author>Nejc Jurkovič</author>
    <!-- <author>Yet another author's name here</author> -->

    <!--[ Licenses ]-->

    <license file="LICENSE-Code">MIT</license>
    <license file="LICENSE-Assets">LGPL-3.0-or-later</license>

    <!--[ Icon ]-->

    <icon>freecad/classy_foundry/resources/icons/classy_foundry.svg</icon>

    <!--[ Urls ]-->

    <url type="repository" branch="master">https://github.com/damogranlabs/classy_foundry</url>
    <url type="documentation">https://github.com/damogranlabs/classy_foundry/tree/master/freecad/classy_foundry/resources/docs/</url>
    <url type="bugtracker">https://github.com/damogranlabs/classy_foundry/issues/</url>
    <url type="readme">https://github.com/damogranlabs/classy_foundry/refs/heads/master/freecad/classy_foundry/resources/docs/Overview.md</url>

    <!--[ Content ]-->

    <content>
        <other/>

        <workbench>
            <name>classy_foundry</name>
            <classname>ClassyFoundryWorkbench</classname>
            <description>GUI for classy_blocks: build OpenFOAM blockMesh meshes visually</description>
            <subdirectory>./</subdirectory>
            <icon>freecad/classy_foundry/resources/icons/classy_foundry-wb.svg</icon>
        </workbench>

    </content>

</package>
